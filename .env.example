# ============================================================
# EchoFlow Voice Agent 环境变量配置
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填入实际的 API Key
# 3. 重要：请勿将 .env 文件提交到版本控制！
# ============================================================

# ==================== API 配置 ====================

# OpenRouter 或 OpenAI-compatible 服务的 API Key（必填）
API_KEY=your-api-key-here

# 默认使用 OpenRouter；使用中转站时改成对应的 /v1 地址
BASE_URL=https://openrouter.ai/api/v1

# 默认使用 OpenRouter 模型 slug；中转站可改成其暴露的模型名
MODEL_NAME=openai/gpt-4.1-mini

# ==================== 应用配置（可选）====================

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# 服务器配置（默认使用 config.yaml 中的配置）
# ECHOFLOW_HOST=0.0.0.0
# ECHOFLOW_PORT=8765

# 自定义配置文件路径
# ECHOFLOW_CONFIG=backend/configs/config.yaml

# 模型缓存目录（默认 outputs/models）
# ECHOFLOW_CACHE_DIR=outputs/models
